# 검토용 예시. 사용자·경로·환경 파일을 준비한 뒤 별도로 설치합니다.
[Unit]
Description=3D Chess Minesweeper account and game server
After=network.target

[Service]
User=chessmine
Group=chessmine
WorkingDirectory=/opt/3dchessmine/server
EnvironmentFile=/etc/chessmine/chessmine.env
ExecStart=/opt/3dchessmine/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:18765 chessmine_server.wsgi:application
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chessmine

[Install]
WantedBy=multi-user.target
